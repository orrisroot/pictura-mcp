# Copy to deploy/pictura-mcp.env (chmod 600) and set the token.
# Values override the defaults baked into pictura_server.py.
# Order: model → device → cache → serving → logging → model-selection extras.

# --- model / compute ---
IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# Restrict which CUDA GPU(s) to use (e.g. "0" or "0,1"); unset = all visible
# IMAGE_CUDA_DEVICE=0
# Model download location (default: HF cache)
# IMAGE_MODEL_CACHE_DIR=/path/to/model-cache

# --- serving (http/sse) ---
# Secret bearer token for remote clients. MUST match --token in the .service file.
PICTURA_MCP_TOKEN=change-me-to-a-long-random-string
# Bind address / TCP port (defaults: 0.0.0.0 seeded by the installer / 8000)
# IMAGE_HOST=0.0.0.0
# IMAGE_PORT=8000

# --- logging ---
# Destination: append [pictura-mcp] logs to a file (default: stderr/journald)
# IMAGE_LOG_FILE=/var/log/pictura-mcp.log

# --- model selection extras ---
# Override the built-in LoRA / ControlNet allowlists (comma-separated; "*" = any)
# IMAGE_LORA_ALLOWLIST=nerijs/pixel-art-xl,CiroN2022/toy-face
# IMAGE_CONTROLNET_ALLOWLIST=diffusers/controlnet-canny-sdxl-1.0
# IMAGE_SKIP_PREFETCH=1   # skip pre-downloading allowlisted models at startup

# The server never writes image files (stateless): results are returned inline
# as base64 and clients save them. No IMAGE_OUTPUT_DIR is used in any mode.
