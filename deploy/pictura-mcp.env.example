# EnvironmentFile for pictura-mcp (systemd); uncomment to override defaults.

# --- model / compute ---
PICTURA_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# PICTURA_CUDA_DEVICE=0                                 # example; default: all visible GPUs
# PICTURA_MODEL_CACHE_DIR=<PROJECT_ROOT>/.model-cache  # example; default: HF cache

# --- serving (http/sse) ---
PICTURA_API_KEY=sk-pictura-change-me-to-a-long-random-string
# PICTURA_HOST=0.0.0.0                                  # example; default: 127.0.0.1
# PICTURA_PORT=8000                                     # default
# PICTURA_PUBLIC_URL=https://gpu.example.com:8000       # example; default: request Host header

# --- image delivery cache (http/sse) ---
# PICTURA_IMAGE_CACHE_TTL=600                          # default; seconds an image URL stays valid
# PICTURA_IMAGE_CACHE_MAX=64                           # default; max cached images
# PICTURA_IMAGE_CACHE_MAX_MB=512                       # default; max total cache bytes

# --- image upload / request body (http/sse) ---
# PICTURA_IMAGE_MAX_BODY_MB=16                         # default; image upload / external-fetch cap
# PICTURA_IMAGE_UPLOAD_TICKET_TTL=120                  # default; upload_image token TTL (s)

# --- logging ---
# PICTURA_LOG_FILE=/var/log/pictura-mcp.log             # example; default: stderr

# --- model selection extras ---
# PICTURA_LORA_ALLOWLIST=org/repo-a,org/repo-b          # example; "*" = any; default: built-in list
# PICTURA_CONTROLNET_ALLOWLIST=org/repo-canny           # example; "*" = any; default: built-in list
# PICTURA_SKIP_PREFETCH=1                               # example; default: off (prefetch on)
