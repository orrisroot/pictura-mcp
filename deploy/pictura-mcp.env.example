# Values override the defaults baked into pictura_server.py.

# --- model / compute ---
PICTURA_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# Restrict which CUDA GPU(s) to use (e.g. "0" or "0,1"); unset = all visible
# PICTURA_CUDA_DEVICE=0
# Model download location (default: HF cache)
# PICTURA_MODEL_CACHE_DIR=<PROJECT_ROOT>/.model-cache

# --- serving (http/sse) ---
# Secret API key for remote clients (sent in the PICTURA_API_KEY header).
# MUST match the --api-key CLI flag when one is passed.
PICTURA_API_KEY=sk-pictura-change-me-to-a-long-random-string
# Bind address / TCP port (defaults: 0.0.0.0 seeded by the installer / 8000)
# PICTURA_HOST=0.0.0.0
# PICTURA_PORT=8000
# Force the externally visible base URL (default: the request's Host header).
# PICTURA_PUBLIC_URL=https://gpu.example.com:8000
# uvicorn forwarded-allow-ips (set when the proxy is not on localhost):
# PICTURA_FORWARDED_ALLOW_IPS=10.0.0.1

# --- image URL return (http/sse) ---
# Short-lived in-memory cache for generated-image download URLs (http/sse).
# PICTURA_IMAGE_URL_TTL=600       # seconds an image URL stays valid
# PICTURA_IMAGE_URL_MAX=64        # max cached images
# PICTURA_IMAGE_URL_MAX_MB=512    # max total cache bytes
# Max HTTP request body = image-upload / external-fetch cap (default 16 MB)
# PICTURA_MAX_BODY_MB=16

# --- logging ---
# Destination: append [pictura-mcp] logs to a file (default: stderr/journald)
# PICTURA_LOG_FILE=/var/log/pictura-mcp.log

# --- model selection extras ---
# Override the built-in LoRA / ControlNet allowlists (comma-separated; "*" = any)
# PICTURA_LORA_ALLOWLIST=nerijs/pixel-art-xl,CiroN2022/toy-face
# PICTURA_CONTROLNET_ALLOWLIST=diffusers/controlnet-canny-sdxl-1.0
# PICTURA_SKIP_PREFETCH=1   # skip pre-downloading allowlisted models at startup
