# EnvironmentFile for pictura-mcp (systemd); uncomment to override defaults.
# Model settings (base model / VAE / LoRA / ControlNet) live in server/model.json
# (deployment-local; presets: server/examples/*.json - copy one to server/model.json)
# (schema: see pictura_server.py, presets: examples/model.*.json).

# --- model / compute ---
# PICTURA_MODEL_CONFIG=/opt/pictura-mcp/server/model.json  # model config path (default: server/model.json; copy a preset from server/examples/)
# PICTURA_DEVICE=cuda                                  # cuda | cpu (default: cuda if available)
# PICTURA_CUDA_DEVICE=0                                # restrict CUDA GPUs, e.g. "0" or "0,1"
# PICTURA_MODELS_DIR=/opt/pictura-mcp/models            # standard local model layout (default: <project>/models)

# --- serving (http/sse) ---
# PICTURA_API_KEY=sk-pictura-change-me-to-a-long-random-string# PICTURA_HOST=0.0.0.0                                 # default: 127.0.0.1
# PICTURA_PORT=8000                                    # default
# PICTURA_PUBLIC_URL=https://gpu.example.com:8000      # for non-loopback binds; reverse proxy: full public URL

# --- image delivery cache (http/sse) ---
# PICTURA_IMAGE_CACHE_TTL=600                          # default; seconds an image URL stays valid
# PICTURA_IMAGE_CACHE_MAX=64                           # default; max cached images
# PICTURA_IMAGE_CACHE_MAX_MB=512                       # default; max total cache bytes

# --- image upload / request body (http/sse) ---
# PICTURA_IMAGE_MAX_BODY_MB=16                         # default; image upload / external-fetch cap
# PICTURA_IMAGE_UPLOAD_TICKET_TTL=120                  # default; upload_image token TTL (s)

# --- logging ---
# PICTURA_LOG_FILE=/var/log/pictura-mcp.log             # default: stderr

# --- startup ---
# PICTURA_MAX_CONCURRENT=1                              # rendering slots (default: auto from VRAM)
