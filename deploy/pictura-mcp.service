# Template: system-level systemd unit running as a dedicated service account.
# Replace <PROJECT_ROOT> and <SERVICE_USER> (or use deploy/install-systemd.sh).
[Unit]
Description=Image generation MCP server (Stable Diffusion on a local GPU)
Documentation=file://<PROJECT_ROOT>/README.md
After=network.target

[Service]
Type=simple
# Run under a dedicated, unprivileged service account (create it first).
User=<SERVICE_USER>
Group=<SERVICE_USER>
WorkingDirectory=<PROJECT_ROOT>
# Token / model / cache / log settings come from this env file (owned by the service user).
EnvironmentFile=<PROJECT_ROOT>/deploy/pictura-mcp.env
# Read-write areas for the service user only (ProtectSystem=strict makes the
# rest of the FS read-only). MCP operation needs only the model cache; the '-'
# prefix tolerates a missing path. install-systemd.sh creates the cache dir
# and rewrites this line from deploy/pictura-mcp.env (PICTURA_MODEL_CACHE_DIR +
# PICTURA_LOG_FILE) — keep them in sync when editing the unit by hand.
ReadWritePaths=-<PROJECT_ROOT>/.model-cache
ExecStart=<PROJECT_ROOT>/.venv/bin/python \
    <PROJECT_ROOT>/server/pictura_server.py \
    --transport http
# Bind address / TCP port come from PICTURA_HOST / PICTURA_PORT in
# deploy/pictura-mcp.env (defaults: 0.0.0.0 / 8000).

# ---- hardening ------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
