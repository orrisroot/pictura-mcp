# pictura-mcp.service — systemd unit for the installed deployment.
# Layout (see README §Remote (http)): app /opt/pictura-mcp, config
# /etc/pictura-mcp/env, service account via /etc/sysusers.d/pictura-mcp.conf.
[Unit]
Description=Image generation MCP server (Stable Diffusion on a local GPU)
Documentation=file:///opt/pictura-mcp/README.md
After=network.target

[Service]
Type=simple
User=pictura-mcp
Group=pictura-mcp
WorkingDirectory=/opt/pictura-mcp
EnvironmentFile=/etc/pictura-mcp/env
# Service home: runtime caches; weights stay read-only.
ReadWritePaths=-/var/lib/pictura-mcp
ExecStart=/opt/pictura-mcp/.venv/bin/python \
    /opt/pictura-mcp/server/pictura_server.py \
    --transport http
# Bind address / TCP port come from PICTURA_HOST / PICTURA_PORT in /etc/pictura-mcp/env.

# ---- hardening ------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
