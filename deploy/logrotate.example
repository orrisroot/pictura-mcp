# logrotate example for the image-mcp server.
# Install as /etc/logrotate.d/image-mcp (root) and adjust the path / user / group.
#
# Ownership model:
#   - the service account (image-mcp) is the WRITER/owner of the log,
#   - readers are: root AND members of the log group (here: image-mcp).
# Add non-root operators to the group once:  sudo usermod -aG image-mcp <operator>
# (or use the distro 'adm' group instead: create 0640 image-mcp adm)

/var/log/image-mcp.log {
    weekly
    rotate 4
    missingok
    notifempty
    compress
    delaycompress

    # Recreate the rotated-in file with the same owner/group/permissions so
    # the service user can keep writing and operators can keep reading.
    create 0640 image-mcp image-mcp

    # OPTION A (recommended, simplest): copytruncate lets the running server
    # keep writing to the same inode - no restart or signal needed.
    copytruncate

    # OPTION B (only if you remove copytruncate above):
    # the server reopens its log file on SIGHUP after rotation:
    # postrotate
    #     pkill -HUP -f "server/image_server.py" || true
    # endscript
}
